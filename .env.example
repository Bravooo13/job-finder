# Where your data is stored (a single SQLite file).
DATABASE_URL=file:./data/job-finder.db

# Your timezone, used for "applied today" counts.
TZ=America/Chicago

# Optional: a Claude API key. Usually you paste it in Settings instead,
# where it's stored encrypted in data/.
# ANTHROPIC_API_KEY=

# Optional: use a Tectonic you installed yourself (otherwise Job Finder finds
# one on your PATH or downloads it into data/bin).
# TECTONIC_PATH=/opt/homebrew/bin/tectonic
