{
  "manifest_version": 3,
  "name": "Job Finder Helper",
  "version": "0.1.0",
  "description": "Send jobs from LinkedIn, Handshake and any careers page to your Job Finder, and fill job applications from your saved answers.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:3737/*", "http://127.0.0.1:3737/*", "https://www.linkedin.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Finder",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["common.js", "sites/linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.joinhandshake.com/*"],
      "js": ["common.js", "sites/handshake.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://jobs.smartrecruiters.com/*"
      ],
      "js": ["common.js", "sites/apply.js"],
      "run_at": "document_idle"
    }
  ]
}
