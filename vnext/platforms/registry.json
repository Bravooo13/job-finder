{
  "version": 1,
  "count": 75,
  "doc": "Builds platforms/registry.json: every application platform Job Finder knows.\n\nconfidence:\n  verified  - used live by Job Finder v1 (feeds and/or forms)\n  documented - a public, no-login endpoint or URL scheme that is widely documented\n  pattern   - recognised by its host; check the feed/form on first use and update this file\nautomation (what the apply driver may do on its own):\n  full      - one-page form, no account: fill, check, submit by your settings\n  fill      - fill and stop for you (account, several pages, or heavy anti-bot)\n  manual    - open it for you; you apply (terms forbid automation, or login-only flows)",
  "platforms": [
    {
      "id": "workday",
      "name": "Workday Recruiting",
      "category": "ats-enterprise",
      "hosts": [
        "\\.myworkdayjobs\\.com$",
        "\\.myworkdaysite\\.com$",
        "\\.myworkday\\.com$"
      ],
      "example": "https://{tenant}.wd5.myworkdayjobs.com/{site}/job/{location}/{title}_{reqId}",
      "feed": {
        "type": "json-post",
        "url": "https://{tenant}.{wdN}.myworkdayjobs.com/wday/cxs/{tenant}/{site}/jobs",
        "notes": "POST {\"appliedFacets\":{},\"limit\":20,\"offset\":0,\"searchText\":\"\"}; detail: GET .../wday/cxs/{tenant}/{site}{externalPath}"
      },
      "apply": {
        "flow": "multi-step",
        "signIn": "required",
        "notes": "Create account/sign in per company (email + password + email verification), then 5-7 pages: My Information, My Experience (resume parse), Application Questions, Voluntary Disclosures, Self Identify, Review. data-automation-id attributes are stable selectors."
      },
      "automation": "fill",
      "confidence": "verified",
      "notes": "~46% of large employers. The owner signs in once per company in the persistent browser profile; the driver then fills page by page and stops at Review."
    },
